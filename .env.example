# Layora Environment Configuration (.env.example)
# Copy this file to .env for local backend/bridge configuration.
# Never commit real API credentials to version control.

# Server & Local Bridge Ports
PORT=3001
BRIDGE_PORT=3002
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001

# Optional Server-Side AI Provider Keys (Users can also configure keys in the UI)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local AI Runtime Default Endpoint (e.g., Ollama / LM Studio)
LOCAL_AI_ENDPOINT=http://127.0.0.1:11434
LOCAL_AI_DEFAULT_MODEL=llama3.2

# Local Bridge Security Pairing Token (Auto-generated if left empty)
BRIDGE_PAIRING_TOKEN=layora-local-dev-token
